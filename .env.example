# CONFIGURACIÓN DE VARIABLES DE ENTORNO

# ============================================
# IMPORTANTE: Copia esto a un archivo llamado .env.local
# y reemplaza los placeholders con valores reales
# ============================================

# API KEY DE GEMINI (se usa únicamente en el servidor)
# Reemplaza este placeholder por tu clave real.
GEMINI_API_KEY=tu_clave_de_gemini

# PUERTO DEL SERVIDOR BACKEND (opcional)
# Por defecto es 3000
# Cambiar si está en uso: npm run server -- --port 3001
PORT=3000

# PUERTO DEL FRONTEND (opcional)
# Vite maneja esto automáticamente
# Por defecto es 5173

# ============================================
# CONFIGURACIÓN DE BASE DE DATOS (opcional)
# PostgreSQL
# DATABASE_URL=postgresql://postgres:password@localhost:5432/evm_projects_db
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=evm_projects_db
# DB_USER=postgres
# DB_PASSWORD=your_password

# SQL Server
# SQLSERVER_CONNECTION_STRING=Server=localhost,1433;Database=evm_projects_db;User Id=sa;Password=your_password;Encrypt=false;TrustServerCertificate=true
# SQL_SERVER=localhost
# SQL_SERVER_PORT=1433
# SQL_SERVER_DATABASE=evm_projects_db
# SQL_SERVER_USER=sa
# SQL_SERVER_PASSWORD=your_password
# SQL_SERVER_ENCRYPT=false
# SQL_SERVER_TRUST_SERVER_CERTIFICATE=true

# ============================================
# AMBIENTE (opcional)
# ============================================

# NODE_ENV=development
# API_URL=http://localhost:3000

# ============================================
# NOTAS IMPORTANTES
# ============================================

# 1. El archivo debe llamarse: .env.local
#    (NO .env.example - ese es para referencia)

# 2. La clave se usa únicamente en el backend:
#    GEMINI_API_KEY=tu_clave_de_gemini

# 3. NO COMMIT este archivo a git
#    Está en .gitignore por seguridad

# 4. Las variables sin prefijo no se exponen al frontend

# 5. Reinicia el servidor después de cambiar estas variables:
#    - Terminal 1: npm run server
#    - Terminal 2: npm run dev

# ============================================
# OBTENER GEMINI API KEY
# ============================================

# 1. Abre la consola de Google AI Studio
# 2. Crea o selecciona una clave de API
# 3. Pégala en GEMINI_API_KEY
# 4. Guarda como .env.local

# ============================================
# VERIFICAR CONFIGURACIÓN
# ============================================

# En una terminal, prueba:
# curl http://localhost:3000/health
#
# Respuesta esperada:
# {"status":"ok","apiKeyConfigured":true}

# ============================================
# TROUBLESHOOTING
# ============================================

# Si "apiKeyConfigured" es false:
# 1. Verifica que .env.local existe (no .env)
# 2. Verifica que GEMINI_API_KEY está configurada
# 3. Reinicia Terminal 1: npm run server

# Si ves "API key is invalid":
# 1. Verifica la clave en la consola de Gemini
# 2. Genera una clave nueva si es necesario

# Si no funciona algo:
# 1. Revisa que GEMINI_API_KEY esté configurada
# 2. Cierra y reabre las terminales
# 3. Limpia el caché del navegador (Ctrl+Shift+Del)
