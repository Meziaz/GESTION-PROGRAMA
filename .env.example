# CONFIGURACIÓN DE VARIABLES DE ENTORNO
#
# Copia este archivo a ".env.local" (NO ".env") y reemplaza los valores
# de ejemplo por los reales. ".env.local" nunca se sube a git.

# ============================================
# BASE DE DATOS (obligatorio)
# PostgreSQL — usa DATABASE_URL o las variables DB_* sueltas, no ambas.
# ============================================

DATABASE_URL=postgresql://postgres:tu_password@localhost:5432/evm_projects_db
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=evm_projects_db
# DB_USER=postgres
# DB_PASSWORD=tu_password
# DB_POOLSIZE=10

# ============================================
# ASISTENTE DE IA (opcional)
# Sin esta clave, todo el resto de la app funciona igual; solo el botón
# "Analizar con IA" del Resumen ejecutivo muestra un aviso en vez de un análisis.
# Se obtiene gratis (sin tarjeta) en https://console.groq.com/keys
# ============================================

GROQ_API_KEY=gsk_tu-clave-aqui

# ============================================
# PUERTO DEL BACKEND (opcional, por defecto 3000)
# ============================================

PORT=3000
